# Helius — https://dashboard.helius.dev
# Covers devnet RPC, webhooks, and the ZK-compression-aware endpoint
# (used instead of standing up a separate Light Protocol / Photon indexer).
HELIUS_API_KEY=
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=

# Pyth price feeds — https://pyth.network
# Public devnet price accounts need no signup to read; only set this if using
# Pyth's Hermes push service.
PYTH_HERMES_URL=

# Squads — https://squads.so
# Deferred to Phase 4 (treasury multisig). Leave empty for Phase 0.
SQUADS_MULTISIG_ADDRESS=

# Anthropic — https://console.anthropic.com
# Powers the agent's tool-use reasoning loop (agent/src/driveWorkflow.ts). Required to run
# `pnpm agent-demo` or the agent trigger server.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Shared secret the agent's trigger server (agent/src/server.ts) checks on incoming
# `Authorization: Bearer <...>` headers — set this on both the server and whatever calls it
# (scripts/devnet/scheduled-trigger.ts, or a real Helius webhook's custom header).
HELIUS_WEBHOOK_SECRET=

# Devnet wallets — populated by scripts/devnet/generate-wallets.ts
BUSINESS_OWNER_KEYPAIR=./wallets/business-owner.json
TREASURY_PLACEHOLDER_KEYPAIR=./wallets/treasury-placeholder.json
TEST_VENDOR_KEYPAIR=./wallets/test-vendor.json
ADVERSARIAL_KEYPAIR=./wallets/adversarial.json


Resume this session with:
claude --resume 9a6bc7bd-a7d7-4d36-a6f7-7c02b2b6b5e1



