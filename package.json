{
  "name": "ashlar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Programmable financial workflow engine for AI agents on Solana.",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "generate-wallets": "tsx scripts/devnet/generate-wallets.ts",
    "hello-world": "tsx scripts/devnet/call-hello-world.ts",
    "deploy-workflow": "tsx scripts/devnet/deploy-workflow.ts",
    "setup-squads-treasury": "tsx scripts/devnet/setup-squads-treasury.ts",
    "x402-vendor-server": "tsx scripts/devnet/x402-vendor-server.ts",
    "register-agent-identity": "tsx scripts/devnet/register-agent-identity.ts",
    "resume-workflow": "tsx --env-file-if-exists=.env scripts/devnet/resume-workflow.ts",
    "agent-server": "tsx --env-file-if-exists=.env agent/src/server.ts",
    "agent-demo": "tsx --env-file-if-exists=.env scripts/devnet/run-agent-demo.ts",
    "scheduled-trigger": "tsx --env-file-if-exists=.env scripts/devnet/scheduled-trigger.ts",
    "test:anchor": "npx ts-mocha -p ./tsconfig.json -t 1000000 \"tests/**/*.ts\"",
    "test:compiler": "pnpm --filter @ashlar/compiler test"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "eslint": "^9.19.0",
    "mocha": "^9.0.3",
    "prettier": "^3.4.2",
    "ts-mocha": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.1.2",
    "@anthropic-ai/sdk": "^0.117.1",
    "@metaplex-foundation/mpl-agent-registry": "^0.2.6",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.0",
    "@sqds/multisig": "^2.1.4",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3",
    "x402-solana": "^3.0.0"
  }
}
